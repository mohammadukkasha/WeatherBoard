# Copy this file to `.env.local` and fill in your free-tier keys.
# Both are optional: without them the app falls back to Open-Meteo
# (weather + geocoding), which needs no key.

# https://home.openweathermap.org/api_keys  (new keys can take ~1-2 hours to activate)
VITE_OWM_API_KEY=

# https://rapidapi.com/wirefreethought/api/geodb-cities  (subscribe to the free BASIC plan)
VITE_GEODB_API_KEY=

# Optional: URL of the reminder push server in server/ (e.g. http://localhost:8787).
# With it, the daily reminder is a real Web Push that arrives even when the tab
# and the app are closed. Without it, reminders fall back to the browser's
# Periodic Background Sync (installed Chromium apps) or fire while the app is open.
VITE_PUSH_SERVER_URL=
