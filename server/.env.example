# Copy to `.env` (never commit it).

PORT=8787

# Comma-separated list of front-end origins allowed to call this server.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Generate with `npm run vapid`. If left empty, keys are generated on first run
# and stored in DATA_DIR/vapid.json (fine locally; set them explicitly in
# production so a redeploy doesn't invalidate every subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@yourdomain or an https URL.
VAPID_SUBJECT=mailto:weatherboard@example.com

# Where subscriptions are stored.
DATA_DIR=./data

# Optional: lets an external scheduler (e.g. cron-job.org) call
# POST /api/cron/tick with `Authorization: Bearer <secret>` every minute,
# which keeps sleeping free-tier hosts awake and on time.
CRON_SECRET=
