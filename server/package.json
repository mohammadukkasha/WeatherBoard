{
  "name": "weatherboard-push-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sends WeatherBoard's daily morning reminder as a Web Push at each user's chosen local time.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "web-push": "^4.0.0"
  }
}
